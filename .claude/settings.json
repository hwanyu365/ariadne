{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(sh .claude/hooks/verify.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git worktree add:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr comment:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(service-account*.json)",
      "Read(*.key)",
      "Read(*.p12)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "onFailure": "block",
            "command": "r=\"$(git rev-parse --show-toplevel)/.github/secret-files.regex\"; [ -s \"$r\" ] || { echo \"$r 없음 → 커밋 차단\" >&2; exit 2; }; f=$({ git -c core.quotePath=false diff --cached --name-only --diff-filter=d; git -c core.quotePath=false ls-files -mo --exclude-standard; } | grep -Ef \"$r\" | grep -vE '\\.example$' | sort -u); [ -z \"$f\" ] || { echo \"비밀 파일이 stage 됐거나 커밋 후보임 → 커밋 차단 (.github/secret-files.regex): $f\" >&2; exit 2; }"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "onFailure": "block",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/verify.sh\" --check"
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "onFailure": "block",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/merge-gate.sh\""
          }
        ]
      }
    ]
  }
}
